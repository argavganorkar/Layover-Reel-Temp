# Copy this file to ".env" (same folder) and adjust as needed.
# ".env" is gitignored, so any keys you add never get committed.

# Which provider does AI clip selection (Phase 4). One of:
#   ollama     - local, free, runs on your own machine (default, no key needed)
#   anthropic  - Claude API (paid, needs ANTHROPIC_API_KEY below)
#   openai     - OpenAI API (paid, needs OPENAI_API_KEY below)
#   gemini     - Google Gemini API (has a genuinely free tier, needs GEMINI_API_KEY below)
# Switching providers is just changing this line and restarting the backend.
LLM_PROVIDER=ollama

# --- Ollama (only used when LLM_PROVIDER=ollama) ---
# Must match a model you've already pulled: ollama pull <name>
OLLAMA_MODEL=llama3.1:8b
# Only change this if you moved Ollama to a non-default address.
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (only used when LLM_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI (only used when LLM_PROVIDER=openai) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Gemini (only used when LLM_PROVIDER=gemini) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
